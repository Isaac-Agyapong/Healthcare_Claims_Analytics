// Healthcare Claims Analytics: DAX measures (reference copy)
// Live definitions: Healthcare_Claims.SemanticModel/definition/tables/claims_clean.tmdl


// ---------- Volume ----------
Total Claims =
    COUNTROWS ( claims_clean )

Decided Claims =
    CALCULATE ( [Total Claims], claims_clean[claim_status] <> "Pending" )

Denied Claims =
    CALCULATE ( [Total Claims], claims_clean[claim_status] = "Denied" )

Unique Patients =
    DISTINCTCOUNT ( claims_clean[patient_id] )


// ---------- Money ----------
Total Billed =
    SUM ( claims_clean[billed_amount] )

Total Paid =
    SUM ( claims_clean[paid_amount] )

Denied Billed $ =
    CALCULATE ( [Total Billed], claims_clean[claim_status] = "Denied" )

Paid to Billed % =
    DIVIDE ( [Total Paid], [Total Billed] )

Paid YTD =
    TOTALYTD ( [Total Paid], DimDate[Date] )


// ---------- Rates ----------
Denial Rate =
    DIVIDE ( [Denied Claims], [Decided Claims] )

Denial Rate (trend) =
    // December 2025 is left out of trend lines: most of its claims are still pending
    IF ( MAX ( DimDate[Date] ) >= DATE ( 2025, 12, 1 ), BLANK (), [Denial Rate] )


// ---------- Providers ----------
Peer Denial Rate =
    // denial rate of all providers with the same claim type and network status
    VAR _type = SELECTEDVALUE ( claims_clean[claim_type] )
    VAR _network = SELECTEDVALUE ( providers_clean[network_status] )
    RETURN
        CALCULATE (
            [Denial Rate],
            REMOVEFILTERS ( providers_clean ),
            claims_clean[claim_type] = _type,
            providers_clean[network_status] = _network
        )

Excess Denial (pts) =
    IF ( NOT ISBLANK ( [Denial Rate] ), ( [Denial Rate] - [Peer Denial Rate] ) * 100 )

Excess Rank =
    IF (
        HASONEVALUE ( providers_clean[provider_name] ),
        RANKX ( ALLSELECTED ( providers_clean[provider_name] ), [Excess Denial (pts)], , DESC )
    )

Top 10 Excess (pts) =
    VAR _rank = [Excess Rank]
    RETURN IF ( NOT ISBLANK ( _rank ) && _rank <= 10, [Excess Denial (pts)] )

Excess Colour =
    IF ( [Excess Denial (pts)] >= 10, "#C98A12", "#C9D1DB" )


// ---------- Time ----------
Avg Days to Process =
    AVERAGE ( claims_clean[days_to_process] )


// ---------- Denials ----------
Prior Auth Denials =
    CALCULATE ( [Denied Claims], claims_clean[denial_reason] = "Missing prior authorization" )

Other Denials =
    [Denied Claims] - [Prior Auth Denials]

Prior Auth Denials 2024 =
    CALCULATE ( [Prior Auth Denials], DimDate[Year] = 2024 )

Prior Auth Denials 2025 =
    CALCULATE ( [Prior Auth Denials], DimDate[Year] = 2025 )

Prior Auth YoY % =
    DIVIDE ( [Prior Auth Denials 2025] - [Prior Auth Denials 2024], [Prior Auth Denials 2024] )


// ---------- Rates ----------
Denial Rate (complete) =
    // December 2025 is left out: most of its claims are still pending
    CALCULATE ( [Denial Rate], KEEPFILTERS ( DimDate[Date] < DATE ( 2025, 12, 1 ) ) )


// ---------- Money ----------
Denied Share of Billed =
    DIVIDE ( [Denied Billed $], [Total Billed] )


// ---------- Denials ----------
Reason Colour =
    IF ( SELECTEDVALUE ( claims_clean[denial_reason] ) = "Missing prior authorization", "#C0392B", "#E6A59E" )


// ---------- Rates ----------
In-Network Denial Rate =
    CALCULATE ( [Denial Rate], providers_clean[network_status] = "In-Network" )

Out-of-Network Denial Rate =
    CALCULATE ( [Denial Rate], providers_clean[network_status] = "Out-of-Network" )


// ---------- Denials ----------
Denials 2024 =
    CALCULATE ( [Denied Claims], DimDate[Year] = 2024 )

Denials 2025 =
    CALCULATE ( [Denied Claims], DimDate[Year] = 2025 )

Denials YoY % =
    DIVIDE ( [Denials 2025] - [Denials 2024], [Denials 2024] )


// ---------- Providers ----------
Flagged Providers =
    COUNTROWS ( FILTER ( VALUES ( providers_clean[provider_name] ), [Excess Denial (pts)] >= 10 ) )

Flagged Denied $ =
    SUMX ( FILTER ( VALUES ( providers_clean[provider_name] ), [Excess Denial (pts)] >= 10 ), [Denied Billed $] )

Flagged Coding Share =
    VAR _flagged = FILTER ( VALUES ( providers_clean[provider_name] ), [Excess Denial (pts)] >= 10 )
    RETURN DIVIDE (
        CALCULATE ( [Denied Claims], _flagged, claims_clean[denial_reason] IN { "Coding error", "Duplicate claim" } ),
        CALCULATE ( [Denied Claims], _flagged ) )


// ---------- Context ----------
KPI Claims Context =
    FORMAT ( [Unique Patients], "#,0" ) & " patients"

KPI Paid Context =
    FORMAT ( [Paid to Billed %], "0%" ) & " of billed charges"

KPI Denial Context =
    FORMAT ( [Denied Claims], "#,0" ) & " of " & FORMAT ( [Decided Claims], "#,0" ) & " decided"

KPI Denied Context =
    FORMAT ( [Denied Share of Billed], "0.0%" ) & " of all billed charges"

KPI Days Context =
    "denied: " & FORMAT ( CALCULATE ( [Avg Days to Process], claims_clean[claim_status] = "Denied" ), "0" )
        & " days  ·  paid: " & FORMAT ( CALCULATE ( [Avg Days to Process], claims_clean[claim_status] = "Paid" ), "0" )

KPI Prior Auth Context =
    "vs " & FORMAT ( [Prior Auth Denials 2024], "#,0" ) & " in 2024"

KPI YoY Context =
    "the fastest-growing denial reason"

KPI Network Context =
    "vs " & FORMAT ( [In-Network Denial Rate], "0.0%" ) & " in-network"

KPI Flagged Context =
    "10+ points above their peers"

KPI Flagged $ Context =
    FORMAT ( DIVIDE ( [Flagged Denied $], [Denied Billed $] ), "0.0%" ) & " of all denied charges"

KPI Coding Context =
    "fixable with a claim scrubber and billing training"

