table DimDate
	lineageTag: 03b83631-4833-5579-bb5a-de6bafaa9e2a
	dataCategory: Time

	column Date
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: d72c33ac-06fc-5015-8c54-7d620b9c65f8
		summarizeBy: none
		isKey
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column Year
		dataType: int64
		formatString: 0
		lineageTag: 31e76285-044a-555e-b04f-7ebe72e75fff
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year]

		annotation SummarizationSetBy = Automatic

	column 'Month Number'
		dataType: int64
		formatString: 0
		lineageTag: b83ab58a-6bb7-590a-998e-726a8db129bc
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month Number]

		annotation SummarizationSetBy = Automatic

	column Month
		dataType: string
		lineageTag: a85a6bc1-a789-5d47-9134-f0b0b6c0b60e
		summarizeBy: none
		isNameInferred
		sortByColumn: 'Month Sort'
		sourceColumn: [Month]

		annotation SummarizationSetBy = Automatic

	column 'Month Sort'
		dataType: int64
		formatString: 0
		lineageTag: 40e0f74c-6a2d-53df-a97a-c4079950f6e7
		summarizeBy: none
		isHidden
		isNameInferred
		sourceColumn: [Month Sort]

		annotation SummarizationSetBy = Automatic

	column Quarter
		dataType: string
		lineageTag: 30b3a788-856e-5272-9927-c536b459f033
		summarizeBy: none
		isNameInferred
		sourceColumn: [Quarter]

		annotation SummarizationSetBy = Automatic

	column 'Quarter Label'
		dataType: string
		lineageTag: 5efe98d4-b7c6-5bc8-aeda-ae29d68f7cd1
		summarizeBy: none
		isNameInferred
		sortByColumn: 'Quarter Sort'
		sourceColumn: [Quarter Label]

		annotation SummarizationSetBy = Automatic

	column 'Quarter Sort'
		dataType: int64
		formatString: 0
		lineageTag: 0cb32236-f5c5-5549-904c-15764a7d82e1
		summarizeBy: none
		isHidden
		isNameInferred
		sourceColumn: [Quarter Sort]

		annotation SummarizationSetBy = Automatic

	partition DimDate = calculated
		mode: import
		source =
				ADDCOLUMNS (
				    CALENDAR ( DATE ( 2024, 1, 1 ), DATE ( 2025, 12, 31 ) ),
				    "Year", YEAR ( [Date] ),
				    "Month Number", MONTH ( [Date] ),
				    "Month", FORMAT ( [Date], "mmm yyyy" ),
				    "Month Sort", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
				    "Quarter", "Q" & QUARTER ( [Date] ),
				    "Quarter Label", YEAR ( [Date] ) & " Q" & QUARTER ( [Date] ),
				    "Quarter Sort", YEAR ( [Date] ) * 10 + QUARTER ( [Date] )
				)
